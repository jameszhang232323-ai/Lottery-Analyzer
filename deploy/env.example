# 大吉大利服务器部署模板（Compose 用）。
# 复制为 deploy/.env 后再修改；.env 已被 .gitignore 忽略，禁止提交真实凭证。
# 生成主密钥：python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

# 镜像标签；升级时改成新版本号，保证 api/worker/scheduler 使用同一镜像。
DAJIDALI_VERSION=0.1.0

# 宿主机只暴露 proxy 的端口；API/DB 不映射到宿主机。
DAJIDALI_HTTP_PORT=8080

# 容器内持久化目录；不要改成非卷路径。
DAJIDALI_DATA_DIR=/data

# 只有通过 HTTPS 访问时才设为 1（Secure Cookie）。纯 HTTP 本机/内网冒烟测试设 0。
DAJIDALI_HTTPS=0

# 32 字节随机主密钥的 base64；占位值不能用于真实部署。
# 与数据库备份分开保管；更换主密钥前必须评估已加密密钥的重新加密方案。
DAJIDALI_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES

# PostgreSQL。DATABASE_URL 中的密码必须与 POSTGRES_PASSWORD 一致；
# 密码含 @ : / 等字符时需 URL 编码。
POSTGRES_DB=dajidali
POSTGRES_USER=dajidali
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://dajidali:change-me@postgres:5432/dajidali

# AI 服务（可选）：三项齐全时 worker 才注册 ai.analyze；留空则 AI 任务明确失败，
# 统计、候选、回测照常可用。密钥只注入 worker 环境，不进入浏览器与镜像。
DAJIDALI_AI_BASE_URL=
DAJIDALI_AI_MODEL=
DAJIDALI_AI_API_KEY=
DAJIDALI_AI_TIMEOUT_SECONDS=60
DAJIDALI_AI_MAX_OUTPUT_TOKENS=2048
